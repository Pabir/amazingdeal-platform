# ==============================================================================
# AmazingDeal Production Environment Variables Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend REST API (services/commerce-api)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# PostgreSQL Cloud Database (AWS RDS / GCP Cloud SQL / Supabase)
# Format: jdbc:postgresql://<HOST>:<PORT>/<DATABASE_NAME>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host.com:5432/amazingdeal_commerce?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# JWT Stateless Token Secret (64+ hex characters or 256-bit base64)
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000

# Media Upload Storage (Local volume or Cloud Object Storage bucket CDN)
APP_MEDIA_UPLOAD_DIR=/app/uploads
APP_MEDIA_BASE_URL=https://api.yourdomain.com/media

# CORS Allowed Origins (Comma-separated or YAML array)
# Allow storefront domains, wildcard subdomains, and admin portal
APP_CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://*.yourdomain.com,https://admin.yourdomain.com

# ------------------------------------------------------------------------------
# 2. Buyer Storefront Web App (apps/storefront-web)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Public REST API URL consumed by Next.js Server & Client Components
NEXT_PUBLIC_API_URL=https://amazingdeal-commerce-api-2pab.onrender.com/api/v1

# ------------------------------------------------------------------------------
# 3. Merchant Admin Web App (apps/admin-web)
# ------------------------------------------------------------------------------
# Public REST API URL consumed by React Vite frontend
VITE_API_BASE_URL=https://amazingdeal-commerce-api-2pab.onrender.com/api/v1
